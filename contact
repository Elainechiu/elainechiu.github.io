    nav .nav-inner {
      max-width: 920px;
      margin: 0 auto;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 999px;
      box-shadow: var(--shadow);
      padding: 14px 16px;
      display: inline-flex;
      gap: 18px;
      flex-wrap: wrap;
      justify-content: center;
    }

    nav a {
      color: var(--link);
      text-decoration: none;
      font-weight: 500;
    }

    nav a:hover {
      color: var(--link-hover);
      text-decoration: underline;
    }

    nav a[aria-current="page"] {
      color: var(--text);
      font-weight: 650;
    }

    main {
      max-width: 920px;
      margin: 0 auto;
      padding: 0 20px 70px;
    }

    section {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 24px;
      box-shadow: var(--shadow);
      margin-top: 22px;
      padding: 28px 30px;
    }

    section:first-of-type {
