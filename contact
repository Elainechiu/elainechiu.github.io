  <style>
    :root {
      --bg: #f7f4ef;
      --surface: #fdfbf7;
      --surface-2: #f3eee7;
      --text: #2a2a2a;
      --muted: #7a766f;
      --border: #e6e0d8;
      --link: #3b6ea8;
      --link-hover: #2f5a8c;
      --shadow: 0 8px 24px rgba(60, 50, 40, 0.08);
      --nav-bg: rgba(253, 251, 247, 0.75);
    }

    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #161513;
        --surface: #1e1c19;
        --surface-2: #26231f;
        --text: #e8e3dc;
        --muted: #b0a79c;
        --border: #3a342c;
        --link: #9bbcf2;
        --link-hover: #c2d6ff;
        --shadow: 0 14px 40px rgba(0, 0, 0, 0.4);
        --nav-bg: rgba(22, 21, 19, 0.75);
      }
    }

    html[data-theme="light"] {
      --bg: #f7f4ef;
      --surface: #fdfbf7;
      --surface-2: #f3eee7;
      --text: #2a2a2a;
      --muted: #7a766f;
      --border: #e6e0d8;
      --link: #3b6ea8;
      --link-hover: #2f5a8c;
      --shadow: 0 8px 24px rgba(60, 50, 40, 0.08);
      --nav-bg: rgba(253, 251, 247, 0.75);
    }

    html[data-theme="dark"] {
      --bg: #161513;
      --surface: #1e1c19;
      --surface-2: #26231f;
      --text: #e8e3dc;
      --muted: #b0a79c;
      --border: #3a342c;
      --link: #9bbcf2;
      --link-hover: #c2d6ff;
      --shadow: 0 14px 40px rgba(0, 0, 0, 0.4);
      --nav-bg: rgba(22, 21, 19, 0.75);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      margin: 0;
      background: linear-gradient(to bottom, var(--bg), #f2ede6);
      color: var(--text);
      line-height: 1.75;
      transition: background-color 0.25s ease, color 0.25s ease;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      background: var(--nav-bg);
      border-bottom: 1px solid var(--border);
    }

    .topbar-inner {
      max-width: 980px;
      margin: 0 auto;
      padding: 14px 20px;
      display: flex;
      justify-content: space-between;
