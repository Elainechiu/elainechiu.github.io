      color: var(--muted);
      font-weight: 600;
      font-size: 15px;
    }

    .contact-value {
      flex: 1 1 240px;
      min-width: 0;
      word-break: break-word;
    }

    footer {
      text-align: center;
      color: var(--muted);
      font-size: 14px;
      margin-top: 34px;
      padding-bottom: 22px;
    }

    .footer-link {
      color: var(--muted);
