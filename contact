    .brand-small {
      font-size: 14px;
      color: var(--muted);
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .theme-toggle {
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: var(--shadow);
    }

    .theme-toggle:hover {
      border-color: var(--link);
      color: var(--link);
    }

    header {
      text-align: center;
      padding: 44px 20px 18px;
    }

    h1 {
      font-size: 34px;
      margin: 0 0 8px 0;
      font-weight: 700;
      letter-spacing: -0.03em;
    }

    .subtitle {
      font-size: 17px;
